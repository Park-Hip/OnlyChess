# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
/md
CONTEXT.md

# Course-era internal docs stay local. docs/modding/ is the modding spec and IS
# tracked — it is the documentation modders read.
# Note: /docs/* not docs/ — git will not descend into an excluded directory, so
# the negation below only works if the directory itself stays unexcluded.
/docs/*
!/docs/modding/
mode.md
AGENTS.md
