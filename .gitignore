# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
/md
CONTEXT.md

# Course-era internal docs stay local. docs/modding/ is the modding spec and
# docs/refactor/ is the live contributor path; both are tracked.
# Note: /docs/* not docs/ — git will not descend into an excluded directory, so
# the negation below only works if the directory itself stays unexcluded.
/docs/*
!/docs/modding/
!/docs/refactor/
!/docs/refactor/**
!/docs/onboarding/
!/docs/onboarding/**
mode.md
AGENTS.md
save_game.json
